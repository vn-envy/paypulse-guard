# --- PayPal sandbox (leave blank to run against the built-in emulator) ---
# developer.paypal.com > Apps & Credentials > Sandbox. Enable "Invoicing" on the app.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Webhook ID from the same app (subscribe to INVOICING.INVOICE.PAID and CUSTOMER.DISPUTE.*).
# Without it, webhooks are rejected and the app falls back to polling PayPal.
PAYPAL_WEBHOOK_ID=
# Sandbox *personal* (buyer) account email. Used only by `npm run seed`.
PAYPAL_BUYER_EMAIL=

# --- LLM (any OpenAI-compatible chat-completions endpoint with tool calling) ---
# Leave LLM_API_KEY blank to use the deterministic rules planner (labelled as such in the UI).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Some OpenAI reasoning models only accept tools on this endpoint with reasoning switched off.
# The app retries with "none" on its own; set it here to skip the failed first call.
# LLM_REASONING_EFFORT=none
# Gemini example:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# --- Guard ---
# PIN the human operator types to unlock signing. Change it for any hosted deploy.
GUARD_OPERATOR_PIN=2468
# HMAC key for approval signatures. Auto-generated into .data/ if blank.
GUARD_SECRET=
# Key for external agents connecting over MCP. Auto-generated into .data/ if blank; set it for a hosted deploy.
GUARD_AGENT_KEY=

# --- Analytics (AG Studio) ---
# Optional. Without it AG Studio runs with a watermark and a console licence notice.
# Request a trial key from AG Grid (info@ag-grid.com). It is sent to the browser, as AG Studio expects.
AG_STUDIO_LICENSE_KEY=
